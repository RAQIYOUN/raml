{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raml",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "22285233-2fb5-4379-8677-b5dcbbbc1e91","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0ac6dd88b56f420aab5203971248806f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
